# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Canonical values for this project live outside the repo in ~/.config/homelab/env
# (mode 600, sourced from ~/.zshrc). This file exists so a fresh clone knows what
# is required. Either source that file or create a local .env.

# Outline — documentation mirror. Token: Outline > Settings > API Tokens
OUTLINE_URL=http://your-outline-host:3000
OUTLINE_KEY=

# Vikunja — task tracking for this project
VIKUNJA_URL=http://your-vikunja-host:3456
VIKUNJA_KEY=

# GitHub — only needed to push; a fine-grained PAT scoped to this repo
GITHUB_TOKEN=
